<!--
    The panel: opens when you click the farmer (or the coins on the strip).
    Its data comes from ViewModels/PanelViewModel.cs.
-->
<Window x:Class="TaskBarGame.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskBarGame: Harvest Edition"
        Width="640"
        Height="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- One upgrade (hoe, armour piece or talisman): what you have now and what's next. -->
        <DataTemplate x:Key="UpgradeRowTemplate">
            <Border Style="{StaticResource Row}" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}" Style="{StaticResource PixelIcon}" Width="36" Height="36"
                           VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="10,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Effect}" Style="{StaticResource Muted}" FontSize="12" />
                        <StackPanel Visibility="{Binding HasNext, Converter={StaticResource BoolToVisibility}}" Margin="0,5,0,0">
                            <TextBlock Text="{Binding NextTitle}" Foreground="{StaticResource GoldBrush}" FontSize="12" />
                            <TextBlock Text="{Binding NextEffect}" Style="{StaticResource Muted}" FontSize="12" />
                            <TextBlock Text="{Binding Cost}" Style="{StaticResource Muted}" FontSize="12" />
                            <TextBlock Text="{Binding Status}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanCraft}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding NextTitle}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="0,5,0,0"
                                   Visibility="{Binding HasNext, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                Visibility="{Binding HasNext, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Craft" Style="{StaticResource AccentButton}"
                                Command="{Binding CraftCommand}" IsEnabled="{Binding CanCraft}" />
                        <!-- Only shows when ingredients are all that's missing. -->
                        <Button Content="{Binding BuyMissingText}" Command="{Binding BuyMissingCommand}"
                                IsEnabled="{Binding CanBuyMissing}" Margin="0,6,0,0" FontSize="12" Padding="8,4"
                                ToolTip="{Binding BuyMissingTip}" ToolTipService.ShowOnDisabled="True"
                                Visibility="{Binding HasMissing, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <DockPanel>

            <!-- Title bar (drag it to move the panel) -->
            <Grid DockPanel.Dock="Top" Height="50" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="{Binding FarmerIcon}" Style="{StaticResource PixelIcon}" Width="32" Height="32" />
                    <TextBlock Text="Harvest Edition" Style="{StaticResource H2}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Image Source="{Binding CoinIcon}" Style="{StaticResource PixelIcon}" Width="16" Height="16" />
                    <TextBlock Text="{Binding CoinsText}" Foreground="{StaticResource GoldBrush}" FontWeight="Bold"
                               FontSize="15" Margin="6,0,12,0" VerticalAlignment="Center" />
                    <Button Content="✕" Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="Close (Esc)" />
                </StackPanel>
            </Grid>

            <TabControl x:Name="Tabs">

                <!-- ============================================================ FIELD -->
                <TabItem Header="Field">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding GardenXpText}"
                                                   Style="{StaticResource Muted}" VerticalAlignment="Bottom" />
                                        <TextBlock Text="{Binding GardenLevelText}" Style="{StaticResource H2}" />
                                    </DockPanel>
                                    <ProgressBar Value="{Binding GardenProgress, Mode=OneWay}" Margin="0,8,0,6" />
                                    <TextBlock Text="{Binding GardenNextText}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <Image Source="{Binding FieldCropIcon}" Style="{StaticResource PixelIcon}" Width="36" Height="36" />
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FieldTitle}" Style="{StaticResource H3}" />
                                            <TextBlock Text="{Binding FieldText}" Style="{StaticResource Muted}" FontSize="12" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <Image Source="{Binding ActiveToolIcon}" Style="{StaticResource PixelIcon}" Width="28" Height="28" />
                                        <TextBlock Text="{Binding ActiveToolText}" Style="{StaticResource Muted}" FontSize="12"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Plant the field with" Style="{StaticResource H3}" Margin="2,2,0,8" />
                            <ItemsControl ItemsSource="{Binding CropChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding PlantCommand}" IsEnabled="{Binding IsUnlocked}"
                                                Width="170" Margin="0,0,6,6" Padding="8,6" HorizontalContentAlignment="Left">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlanted}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Background" Value="{StaticResource RowBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <DockPanel Width="152">
                                                <Image Source="{Binding Icon}" Style="{StaticResource PixelIcon}" Width="28" Height="28" />
                                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource Card}" Margin="0,6,0,0"
                                    Visibility="{Binding HasExpansion, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Expand"
                                            Command="{Binding ExpandCommand}" IsEnabled="{Binding CanExpand}"
                                            VerticalAlignment="Center" />
                                    <Image Source="{Binding LockIcon}" Style="{StaticResource PixelIcon}" Width="32" Height="32" />
                                    <StackPanel Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ExpansionTitle}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ExpansionText}" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============================================================ FARMING -->
                <TabItem Header="Farming">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding FarmingXpText}"
                                                   Style="{StaticResource Muted}" VerticalAlignment="Bottom" />
                                        <TextBlock Text="{Binding FarmingLevelText}" Style="{StaticResource H2}" />
                                    </DockPanel>
                                    <ProgressBar Value="{Binding FarmingProgress, Mode=OneWay}"
                                                 Foreground="{StaticResource XpBrush}" Margin="0,8,0,6" />
                                    <TextBlock Text="{Binding FarmingNextText}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding FortuneTitle}" Style="{StaticResource H3}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8" FontSize="12"
                                               Text="Every 100 Harvest Fortune gives one extra set of drops per crop broken. Leftover fortune is a chance at one more." />
                                    <ItemsControl ItemsSource="{Binding FortuneLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,10" />
                                    <TextBlock Text="{Binding SpeedText}" Margin="0,1" />
                                    <TextBlock Text="{Binding SellBonusText}" Margin="0,1" />
                                    <TextBlock Text="{Binding XpBonusText}" Margin="0,1" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Crop guide" Style="{StaticResource H3}" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,6" TextWrapping="Wrap"
                                               Text="Coins an hour: roughly what the farmer makes farming only that crop and selling it to the Market, with your hoes, Fortune and speed." />
                                    <ItemsControl ItemsSource="{Binding CropGuide}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4" Opacity="{Binding RowOpacity}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding Icon}" Style="{StaticResource PixelIcon}" />
                                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="12" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeBrush}"
                                                                   FontSize="12" HorizontalAlignment="Right" />
                                                        <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="5,0"
                                                                HorizontalAlignment="Right" Margin="0,2,0,0"
                                                                Visibility="{Binding IsBest, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="BEST FOR COINS" Foreground="{StaticResource AccentTextBrush}"
                                                                       FontSize="10" FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Stats" Style="{StaticResource H3}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding StatsText}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============================================================ UPGRADES -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Upgrades" />
                            <!-- How many upgrades you can craft right now -->
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="8" MinWidth="16" Height="16"
                                    Padding="4,0" Margin="5,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Upgrades you can craft right now"
                                    Visibility="{Binding ReadyUpgrades, Converter={StaticResource CountToVisibility}}">
                                <TextBlock Text="{Binding ReadyUpgrades}" Foreground="{StaticResource AccentTextBrush}"
                                           FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Style="{StaticResource Muted}" Margin="2,0,0,10"
                                       Text="Upgrades are crafted from packed crops (160 crops = 1 Packed, 160 Packed = 1 Dense). Pack crops in the Inventory tab, or press Buy missing to get them from the Bazaar." />

                            <TextBlock Text="Hoes" Style="{StaticResource H3}" Margin="2,0,0,2" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="2,0,0,8"
                                       Text="Each crop has its own hoe. The farmer switches to the right one automatically." />
                            <ItemsControl ItemsSource="{Binding UnlockedToolRows}" ItemTemplate="{StaticResource UpgradeRowTemplate}" />

                            <TextBlock Text="Armour" Style="{StaticResource H3}" Margin="2,12,0,2" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="2,0,0,8"
                                       Text="Straw → Harvester → Verdant. Wear all four pieces of a set for its set bonus." />
                            <ItemsControl ItemsSource="{Binding ArmourRows}" ItemTemplate="{StaticResource UpgradeRowTemplate}" />

                            <TextBlock Text="Talismans" Style="{StaticResource H3}" Margin="2,12,0,2" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="2,0,0,8"
                                       Text="Charm → Ring → Relic. Owning one is enough: it works from your pocket. Merchant's raises Market prices (not the Bazaar)." />
                            <ItemsControl ItemsSource="{Binding TalismanRows}" ItemTemplate="{StaticResource UpgradeRowTemplate}" />

                            <TextBlock Text="Compactor" Style="{StaticResource H3}" Margin="2,12,0,2" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="2,0,0,8"
                                       Text="Packs crops for you as they're harvested. It leaves alone any plain crops your next upgrades need." />
                            <ItemsControl ItemsSource="{Binding CompactorRows}" ItemTemplate="{StaticResource UpgradeRowTemplate}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============================================================ COLLECTIONS -->
                <TabItem Header="Collections">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Style="{StaticResource Muted}" Margin="2,0,0,10"
                                       Text="Every crop you harvest counts toward its collection. Each tier gives that crop more Harvest Fortune, plus Garden XP. Hover over a crop to see every tier." />
                            <ItemsControl ItemsSource="{Binding CollectionRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}" Opacity="{Binding RowOpacity}" ToolTip="{Binding TiersTip}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Icon}" Style="{StaticResource PixelIcon}" Width="32" Height="32" />
                                                <StackPanel Grid.Column="1" Margin="10,0,4,0">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TierText}"
                                                                   Foreground="{StaticResource GoldBrush}" FontSize="12" />
                                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                    </DockPanel>
                                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                                                 Foreground="{Binding ProgressBrush}" Height="6" Margin="0,5" />
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding RewardText}"
                                                                   Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                        <TextBlock Text="{Binding CountText}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding MaxText}" Foreground="{StaticResource GoldBrush}" FontSize="11"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============================================================ BAZAAR -->
                <TabItem Header="Bazaar">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="2,0,0,8"
                                   Text="Trade with other farmers. It usually pays more than the Market. Prices move every minute." />

                        <!-- Your buy orders and sell offers -->
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="10"
                                Visibility="{Binding HasOrders, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Your orders" Style="{StaticResource H3}" Margin="0,0,0,6" />
                                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Orders}" Margin="0,0,6,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3">
                                                    <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}"
                                                            Style="{StaticResource DangerButton}" VerticalAlignment="Center" />
                                                    <Grid Width="28" Height="28">
                                                        <Image Source="{Binding Container}" Style="{StaticResource PixelIcon}" Width="28" Height="28"
                                                               Visibility="{Binding HasContainer, Converter={StaticResource BoolToVisibility}}" />
                                                        <Image Source="{Binding Icon}" Style="{StaticResource PixelIcon}" Width="28" Height="28"
                                                               Visibility="{Binding HasContainer, Converter={StaticResource InverseBoolToVisibility}}" />
                                                        <Image Source="{Binding Icon}" Style="{StaticResource PixelIcon}" Width="14" Height="14"
                                                               VerticalAlignment="Bottom" Margin="0,0,0,4"
                                                               Visibility="{Binding HasContainer, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                    <StackPanel Margin="10,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="5" Margin="0,4" />
                                                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}" FontSize="11" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="268" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Every item and its prices, with a search box on top -->
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,6,6">
                                    <TextBox x:Name="BazaarSearchBox" Text="{Binding BazaarSearch, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Type part of a name, like &quot;melon&quot;" />
                                    <TextBlock Text="🔍  Search, e.g. melon" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                               Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding Text.IsEmpty, ElementName=BazaarSearchBox, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding BazaarRows}" Margin="0,0,6,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding SelectCommand}" Margin="0,0,0,4" Padding="8,5"
                                                    HorizontalContentAlignment="Stretch">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="{StaticResource RowBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <DockPanel Width="226">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TrendText}" Foreground="{Binding TrendBrush}"
                                                               FontSize="11" VerticalAlignment="Center" />
                                                    <Grid Width="26" Height="26">
                                                        <Image Source="{Binding Container}" Style="{StaticResource PixelIcon}" Width="26" Height="26"
                                                               Visibility="{Binding HasContainer, Converter={StaticResource BoolToVisibility}}" />
                                                        <Image Source="{Binding Icon}" Style="{StaticResource PixelIcon}" Width="26" Height="26"
                                                               Visibility="{Binding HasContainer, Converter={StaticResource InverseBoolToVisibility}}" />
                                                        <Image Source="{Binding Icon}" Style="{StaticResource PixelIcon}" Width="13" Height="13"
                                                               VerticalAlignment="Bottom" Margin="0,0,0,4"
                                                               Visibility="{Binding HasContainer, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                    <StackPanel Margin="8,0,4,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding PriceText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            </DockPanel>

                            <!-- Trading box for the selected item -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,6,0" VerticalAlignment="Top">
                                <StackPanel>
                                    <DockPanel>
                                        <Grid Width="40" Height="40">
                                            <Image Source="{Binding SelectedContainer}" Style="{StaticResource PixelIcon}" Width="40" Height="40"
                                                   Visibility="{Binding SelectedHasContainer, Converter={StaticResource BoolToVisibility}}" />
                                            <Image Source="{Binding SelectedIcon}" Style="{StaticResource PixelIcon}" Width="40" Height="40"
                                                   Visibility="{Binding SelectedHasContainer, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <Image Source="{Binding SelectedIcon}" Style="{StaticResource PixelIcon}" Width="20" Height="20"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,6"
                                                   Visibility="{Binding SelectedHasContainer, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedName}" Style="{StaticResource H3}" />
                                            <TextBlock Text="{Binding SelectedHaveText}" Style="{StaticResource Muted}" FontSize="12" />
                                        </StackPanel>
                                    </DockPanel>

                                    <TextBlock Text="{Binding SelectedSellText}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding SelectedBuyText}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding SelectedTrendText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />

                                    <!-- The price over the last 2 hours -->
                                    <Border x:Name="ChartHost" Height="40" Margin="0,8,0,0" Background="{StaticResource TrackBrush}"
                                            CornerRadius="4" ClipToBounds="True"
                                            Visibility="{Binding HasChart, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Polygon Points="{Binding ChartArea}" Fill="#267BC950" />
                                            <Polyline Points="{Binding ChartPoints}" Stroke="{StaticResource AccentBrush}"
                                                      StrokeThickness="2" StrokeLineJoin="Round" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding ChartText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" />

                                    <TextBlock Text="How many?" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                                            <Button Content="1" Command="{Binding AmountOneCommand}" Padding="8,4" Margin="0,0,3,0" />
                                            <Button Content="10" Command="{Binding AmountTenCommand}" Padding="8,4" Margin="0,0,3,0" />
                                            <Button Content="160" Command="{Binding AmountStackCommand}" Padding="8,4" Margin="0,0,3,0" />
                                            <Button Content="All" Command="{Binding AmountAllCommand}" Padding="8,4"
                                                    ToolTip="Everything you have of this" />
                                        </StackPanel>
                                        <TextBox Text="{Binding BazaarAmount, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>

                                    <!-- Left column sells, right column buys. Orders can have your own price. -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button Content="{Binding InstantSellText}" Command="{Binding InstantSellCommand}"
                                                IsEnabled="{Binding CanInstantSell}" Style="{StaticResource AccentButton}"
                                                ToolTip="Sell straight away at the sell price" />
                                        <Button Grid.Column="2" Content="{Binding InstantBuyText}" Command="{Binding InstantBuyCommand}"
                                                IsEnabled="{Binding CanInstantBuy}" Style="{StaticResource AccentButton}"
                                                ToolTip="Buy straight away at the buy price" />

                                        <Grid Grid.Row="1" Margin="0,8,0,4">
                                            <TextBox x:Name="OfferPriceBox" Text="{Binding OfferPriceInput, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="The price you want for each item. Leave it empty for the automatic price." />
                                            <TextBlock Text="{Binding OfferPriceHint}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                       Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                       Visibility="{Binding Text.IsEmpty, ElementName=OfferPriceBox, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <Grid Grid.Row="1" Grid.Column="2" Margin="0,8,0,4">
                                            <TextBox x:Name="OrderPriceBox" Text="{Binding OrderPriceInput, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="The price you'll pay for each item. Leave it empty for the automatic price." />
                                            <TextBlock Text="{Binding OrderPriceHint}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                       Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                       Visibility="{Binding Text.IsEmpty, ElementName=OrderPriceBox, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>

                                        <Button Grid.Row="2" Content="{Binding SellOfferText}" Command="{Binding SellOfferCommand}"
                                                IsEnabled="{Binding CanSellOffer}"
                                                ToolTip="Ask for more than the sell price. It fills over time, when buyers pay that much." />
                                        <Button Grid.Row="2" Grid.Column="2" Content="{Binding BuyOrderText}" Command="{Binding BuyOrderCommand}"
                                                IsEnabled="{Binding CanBuyOrder}"
                                                ToolTip="Offer less than the buy price. It fills over time, when sellers drop to that price." />
                                    </Grid>
                                    <TextBlock Text="{Binding PriceWarning}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="{Binding PriceWarning, Converter={StaticResource TextToVisibility}}" />

                                    <TextBlock Text="{Binding BazaarMessage}" Foreground="{StaticResource GoldBrush}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <!-- ============================================================ INVENTORY -->
                <TabItem Header="Inventory">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Pack everything" Command="{Binding PackEverythingCommand}" Margin="0,0,8,0"
                                                    ToolTip="Pack every 160 crops into 1 Packed, and every 160 Packed into 1 Dense" />
                                            <Button Style="{StaticResource AccentButton}" Content="Sell all crops"
                                                    Command="{Binding SellAllCropsCommand}" IsEnabled="{Binding HasCrops}"
                                                    ToolTip="Sells plain crops to the Market, except locked ones and what your next upgrades need. Packed and Dense crops are kept for crafting. (The Bazaar usually pays more.)" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="The Market pays for your crops" Style="{StaticResource Muted}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Image Source="{Binding CoinIcon}" Style="{StaticResource PixelIcon}" Width="18" Height="18" />
                                                <TextBlock Text="{Binding CropsValueText}" Foreground="{StaticResource GoldBrush}"
                                                           FontSize="18" FontWeight="Bold" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                    <CheckBox Content="Keep enough crops for my next upgrades when selling to the Market"
                                              IsChecked="{Binding KeepForUpgrades}" Margin="0,10,0,0"
                                              ToolTip="Sell, Sell all crops and auto-sell keep back what your next hoes, armour, talismans and Compactor need, including crops you still have to pack." />
                                    <TextBlock Text="{Binding KeptSummary}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"
                                               TextWrapping="Wrap" Visibility="{Binding KeptSummary, Converter={StaticResource TextToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Nothing here yet. Go break some crops!" Style="{StaticResource Muted}" Margin="4,0,4,10"
                                       Visibility="{Binding HasInventory, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Inventory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}">
                                            <DockPanel>
                                                <!-- Fixed widths so Lock, Pack and Sell line up from row to row -->
                                                <Button DockPanel.Dock="Right" Content="{Binding SellText}" Command="{Binding SellCommand}"
                                                        IsEnabled="{Binding CanSell}" Width="170" VerticalAlignment="Center"
                                                        ToolTip="Sell to the Market" />
                                                <Button DockPanel.Dock="Right" Content="Pack ▾" Click="Pack_Click" Width="76" Margin="0,0,6,0"
                                                        VerticalAlignment="Center" ToolTip="{Binding PackTip}"
                                                        Visibility="{Binding CanPack, Converter={StaticResource BoolToHidden}}" />
                                                <CheckBox DockPanel.Dock="Right" Content="Lock" IsChecked="{Binding IsLocked}" FontSize="12"
                                                          Margin="8,0,10,0" VerticalAlignment="Center"
                                                          ToolTip="Locked items are never sold: not by any Sell button, auto-sell or the Bazaar." />
                                                <Grid Width="32" Height="32">
                                                    <Image Source="{Binding Container}" Style="{StaticResource PixelIcon}" Width="32" Height="32"
                                                           Visibility="{Binding HasContainer, Converter={StaticResource BoolToVisibility}}" />
                                                    <Image Source="{Binding Icon}" Style="{StaticResource PixelIcon}" Width="32" Height="32"
                                                           Visibility="{Binding HasContainer, Converter={StaticResource InverseBoolToVisibility}}" />
                                                    <Image Source="{Binding Icon}" Style="{StaticResource PixelIcon}" Width="16" Height="16"
                                                           VerticalAlignment="Bottom" Margin="0,0,0,5"
                                                           Visibility="{Binding HasContainer, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                                <StackPanel Margin="10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" FontSize="12" />
                                                    <TextBlock Text="{Binding KeptText}" Foreground="{StaticResource GoldBrush}" FontSize="11"
                                                               Visibility="{Binding HasKeptText, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Auto-sell:" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Button Content="All" Command="{Binding AutoSellAllCommand}" Padding="8,3" Margin="0,0,4,0" FontSize="12" />
                                            <Button Content="None" Command="{Binding AutoSellNoneCommand}" Padding="8,3" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Text="Auto-sell &amp; Compactor" Style="{StaticResource H3}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"
                                               Text="Auto-sell sells a crop to the Market as soon as it's harvested. The Compactor (crafted in Upgrades) packs crops as they're harvested." />
                                    <ItemsControl ItemsSource="{Binding CropSettings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2" Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding Icon}" Style="{StaticResource PixelIcon}" Width="20" Height="20" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                                    <CheckBox Grid.Column="2" Content="Auto-sell" IsChecked="{Binding AutoSell}" FontSize="12"
                                                              VerticalAlignment="Center" />
                                                    <CheckBox Grid.Column="3" Content="Compactor" IsChecked="{Binding Compact}" FontSize="12"
                                                              VerticalAlignment="Center"
                                                              Visibility="{Binding HasCompactor, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding KeptText}" Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding KeptText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============================================================ SETTINGS -->
                <TabItem Header="Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Field strip" Style="{StaticResource H3}" />
                                    <StackPanel Margin="0,6,0,0">
                                        <RadioButton Content="Always show it above the taskbar" IsChecked="{Binding ModeAlways}" />
                                        <RadioButton Content="Only show it when I hover over the farmer" IsChecked="{Binding ModeHover}" />
                                    </StackPanel>
                                    <TextBlock Text="Size" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Small" IsChecked="{Binding SizeSmall}" />
                                        <RadioButton Content="Normal" IsChecked="{Binding SizeNormal}" />
                                        <RadioButton Content="Large" IsChecked="{Binding SizeLarge}" />
                                    </StackPanel>
                                    <TextBlock Text="Position" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Left" IsChecked="{Binding AnchorLeft}" />
                                        <RadioButton Content="Center" IsChecked="{Binding AnchorCenter}" />
                                        <RadioButton Content="Right" IsChecked="{Binding AnchorRight}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Gameplay" Style="{StaticResource H3}" Margin="0,0,0,4" />
                                    <CheckBox Content="Farmer farms the row by themselves" IsChecked="{Binding AutoHarvest}" />
                                    <CheckBox Content="Keep enough crops for my next upgrades when selling to the Market" IsChecked="{Binding KeepForUpgrades}" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="26,0,0,4" TextWrapping="Wrap"
                                               Text="Auto-sell is chosen crop by crop at the bottom of the Inventory tab." />
                                    <CheckBox Content="Start the Harvest Edition when Windows starts" IsChecked="{Binding StartWithWindows}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Display" Style="{StaticResource H3}" Margin="0,0,0,4" />
                                    <CheckBox Content="Show floating numbers when crops are broken" IsChecked="{Binding FloatingText}" />
                                    <CheckBox Content="Short numbers (12.3K and 1.23M instead of 12,345 and 1,234,567)" IsChecked="{Binding ShortNumbers}" />
                                    <CheckBox Content="Hide the field during fullscreen games and videos" IsChecked="{Binding HideInFullscreen}" />
                                    <CheckBox Content="Battery saver: animate less often while the laptop is on battery" IsChecked="{Binding BatterySaver}"
                                              ToolTip="The farmer and your crops keep the same pace; only the animation is less smooth. The game also slows down its updates while it's hidden behind a fullscreen app." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Pop-ups" Style="{StaticResource H3}" Margin="0,0,0,4" />
                                    <CheckBox Content="Pause all pop-ups for now" IsChecked="{Binding PausePopups}" FontWeight="SemiBold" />
                                    <TextBlock Text="Show a pop-up for:" Style="{StaticResource Muted}" Margin="0,6,0,2" />
                                    <WrapPanel IsEnabled="{Binding PausePopups, Converter={StaticResource Not}}">
                                        <CheckBox Content="Level-ups" IsChecked="{Binding PopupLevelUps}" Width="190" />
                                        <CheckBox Content="Collection tiers" IsChecked="{Binding PopupCollections}" Width="190" />
                                        <CheckBox Content="Upgrades ready to craft" IsChecked="{Binding PopupUpgradeReady}" Width="190" />
                                        <CheckBox Content="Crafted upgrades" IsChecked="{Binding PopupCrafted}" Width="190" />
                                        <CheckBox Content="Bazaar orders filled" IsChecked="{Binding PopupBazaar}" Width="190" />
                                        <CheckBox Content="Welcome back report" IsChecked="{Binding PopupWelcomeBack}" Width="190" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Save file" Style="{StaticResource H3}" />
                                    <TextBlock Text="{Binding SavePath, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,10" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Quit game" Click="Quit_Click" Margin="0,0,8,0" />
                                        <Button Content="Reset progress..." Style="{StaticResource DangerButton}" Click="Reset_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
