<!--
    The garden strip that sits just above the taskbar.
    The window is mostly see-through: transparent areas let clicks pass to whatever is behind.
    Everything inside is laid out in code (StripWindow.xaml.cs) because sizes depend on the
    Size setting, the number of plots and the screen's DPI.
-->
<Window x:Class="TaskBarGame.App.StripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskBarGame"
        Width="360"
        Height="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">
    <Canvas x:Name="Root" />
</Window>
