<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TaskBarGame.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pixel art lives in a text file so it can be edited without image tools. -->
    <EmbeddedResource Include="Assets\sprites.txt" LogicalName="TaskBarGame.Core.Assets.sprites.txt" />
  </ItemGroup>

</Project>
